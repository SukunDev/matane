{
  "name": "@matane/extension-cli",
  "version": "0.1.0",
  "description": "mr-ext: create, build, test and publish Matane extensions",
  "keywords": [
    "matane",
    "manga",
    "extension",
    "cli"
  ],
  "license": "MIT",
  "author": "SukunDev",
  "homepage": "https://sukundev.github.io/matane/extensions/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SukunDev/matane.git",
    "directory": "packages/extension-cli"
  },
  "bugs": "https://github.com/SukunDev/matane/issues",
  "type": "module",
  "bin": {
    "mr-ext": "bin/mr-ext.js"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "bin": {
      "mr-ext": "dist/cli.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@matane/extension-runtime": "workspace:*",
    "@matane/extension-sdk": "workspace:*",
    "commander": "15.0.0",
    "esbuild": "0.28.2",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "@types/yazl": "3.3.1",
    "tsx": "4.23.15"
  }
}
