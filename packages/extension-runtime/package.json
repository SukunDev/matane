{
  "name": "@matane/extension-runtime",
  "version": "0.2.0",
  "description": "The sandboxed QuickJS runtime that runs Matane extensions, shared by the app and mr-ext",
  "keywords": [
    "matane",
    "extension",
    "quickjs",
    "sandbox"
  ],
  "license": "MIT",
  "author": "SukunDev",
  "homepage": "https://mataneorg.github.io/matane/extensions/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mataneorg/matane.git",
    "directory": "packages/extension-runtime"
  },
  "bugs": "https://github.com/mataneorg/matane/issues",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./http-bridge": "./src/http-bridge.ts",
    "./repo": "./src/repo.ts",
    "./image": "./src/image.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./http-bridge": {
        "types": "./dist/http-bridge.d.ts",
        "default": "./dist/http-bridge.js"
      },
      "./repo": {
        "types": "./dist/repo.d.ts",
        "default": "./dist/repo.js"
      },
      "./image": {
        "types": "./dist/image.d.ts",
        "default": "./dist/image.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@matane/extension-sdk": "workspace:*",
    "cheerio": "1.2.0",
    "quickjs-emscripten": "0.32.0",
    "sharp": "0.35.5",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "yazl": "3.3.1"
  }
}
