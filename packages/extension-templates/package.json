{
  "name": "@matane/extension-templates",
  "version": "0.2.0",
  "description": "Ready-made sources for sites on popular CMS themes (Madara, MangaThemesia), for Matane extensions",
  "keywords": [
    "matane",
    "manga",
    "extension",
    "madara",
    "mangathemesia"
  ],
  "license": "MIT",
  "author": "SukunDev",
  "homepage": "https://sukundev.github.io/matane/extensions/templates",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SukunDev/matane.git",
    "directory": "packages/extension-templates"
  },
  "bugs": "https://github.com/SukunDev/matane/issues",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@matane/extension-sdk": "workspace:*"
  }
}
