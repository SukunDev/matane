<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>dev.sukun.matane</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <name>Matane</name>
  <summary>Read manga, manhwa and webtoons from your library</summary>
  <developer id="dev.sukun">
    <name>SukunDev</name>
  </developer>
  <description>
    <p>
      Matane is an open-source desktop manga reader. Keep a library with reading progress, read in
      paged or webtoon mode, download chapters for offline reading and get told about new chapters.
    </p>
    <p>
      Sources come from extensions that run in a sandbox: they can only reach the sites they list
      and never touch your files. Matane itself hosts no content.
    </p>
    <ul>
      <li>Paged, double-page and webtoon reading with zoom, colour filters and remappable keys</li>
      <li>Downloads as CBZ or folders, read offline</li>
      <li>Categories, history, reading statistics and backups</li>
      <li>Catppuccin themes, DNS-over-HTTPS and proxy settings</li>
    </ul>
  </description>
  <launchable type="desktop-id">dev.sukun.matane.desktop</launchable>
  <url type="homepage">https://mataneorg.github.io/matane/</url>
  <url type="bugtracker">https://github.com/mataneorg/matane/issues</url>
  <url type="vcs-browser">https://github.com/mataneorg/matane</url>
  <url type="help">https://mataneorg.github.io/matane/guide/</url>
